{
  "app-id": "dev.savagecore.EglantineLauncher",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "eglantine-launcher",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "eglantine-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/eglantine-launcher /app/bin /app/share/applications /app/share/icons/hicolor/scalable/apps /app/share/metainfo",
        "cp -r eglantine_launcher /app/lib/eglantine-launcher/",
        "find /app/lib/eglantine-launcher -name __pycache__ -type d -prune -exec rm -rf {} +",
        "install -m755 packaging/eglantine-launcher.sh /app/bin/eglantine-launcher",
        "sed -i 's|/usr/lib/eglantine-launcher|/app/lib/eglantine-launcher|' /app/bin/eglantine-launcher",
        "install -m644 packaging/dev.savagecore.EglantineLauncher.desktop /app/share/applications/",
        "install -m644 data/icons/eglantine-launcher.svg /app/share/icons/hicolor/scalable/apps/eglantine-launcher.svg",
        "install -m644 data/dev.savagecore.EglantineLauncher.metainfo.xml /app/share/metainfo/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
